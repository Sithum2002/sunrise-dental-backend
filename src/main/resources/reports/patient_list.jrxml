<?xml version="1.0" encoding="UTF-8"?><jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="patient_list" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">

    <parameter name="TITLE" class="java.lang.String"/>
    <parameter name="CLINIC_NAME" class="java.lang.String"/>
    <parameter name="CLINIC_ADDRESS" class="java.lang.String"/>
    <parameter name="CLINIC_PHONE" class="java.lang.String"/>
    <parameter name="CLINIC_EMAIL" class="java.lang.String"/>
    <parameter name="CLINIC_TIN" class="java.lang.String"/>
    <parameter name="CURRENCY" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="PERIOD" class="java.lang.String"/>

    <field name="regNo" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="contact" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="gender" class="java.lang.String"/>
    <field name="bloodGroup" class="java.lang.String"/>
    <field name="createdDate" class="java.lang.String"/>

    <title>
        <band height="86" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="515" height="26"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CLINIC_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="28" width="515" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="48" width="515" height="16"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Scope: " + $P{PERIOD}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="66" width="515" height="16"/>
                <textElement textAlignment="Right">
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="24"/>
                <graphicElement fill="Solid">
                    <color red="31" green="58" blue="147"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="6" y="3" width="70" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Reg No]]></text>
            </staticText>
            <staticText>
                <reportElement x="78" y="3" width="150" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Patient Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="3" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Contact]]></text>
            </staticText>
            <staticText>
                <reportElement x="322" y="3" width="110" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Gender]]></text>
            </staticText>
            <staticText>
                <reportElement x="434" y="3" width="75" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Registered]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <textField>
                <reportElement x="6" y="2" width="70" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{regNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="78" y="2" width="150" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="230" y="2" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{contact}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="322" y="2" width="110" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{gender}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="434" y="2" width="75" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdDate}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="21" width="515" height="1"/>
                <graphicElement lineWidth="1" lineColor="#DDDDDD"/>
            </line>
        </band>
    </detail>
</jasperReport>
