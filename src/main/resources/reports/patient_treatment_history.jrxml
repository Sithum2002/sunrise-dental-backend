<?xml version="1.0" encoding="UTF-8"?><jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="patient_treatment_history" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">

    <parameter name="TITLE" class="java.lang.String"/>
    <parameter name="CLINIC_NAME" class="java.lang.String"/>
    <parameter name="CLINIC_ADDRESS" class="java.lang.String"/>
    <parameter name="CLINIC_PHONE" class="java.lang.String"/>
    <parameter name="CLINIC_EMAIL" class="java.lang.String"/>
    <parameter name="CLINIC_TIN" class="java.lang.String"/>
    <parameter name="CURRENCY" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="PATIENT_NAME" class="java.lang.String"/>
    <parameter name="PATIENT_REG_NO" class="java.lang.String"/>
    <parameter name="PATIENT_CONTACT" class="java.lang.String"/>

    <field name="appointmentNumber" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="dentistName" class="java.lang.String"/>
    <field name="treatmentName" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="billNumber" class="java.lang.String"/>
    <field name="totalAmount" class="java.lang.String"/>
    <field name="amountPaid" class="java.lang.String"/>
    <field name="dueAmount" class="java.lang.String"/>

    <title>
        <band height="128" splitType="Stretch">
            <textField>
                <reportElement x="0" y="0" width="515" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CLINIC_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="26" width="515" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITLE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="52" width="110" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Patient:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="52" width="180" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PATIENT_NAME} + " (" + $P{PATIENT_REG_NO} + ")"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="70" width="110" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Contact:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="70" width="180" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PATIENT_CONTACT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="108" width="515" height="16"/>
                <textElement textAlignment="Right">
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="24"/>
                <graphicElement fill="Solid">
                    <color red="31" green="58" blue="147"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="6" y="3" width="100" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Appointment No]]></text>
            </staticText>
            <staticText>
                <reportElement x="108" y="3" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="3" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Dentist]]></text>
            </staticText>
            <staticText>
                <reportElement x="282" y="3" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Treatment]]></text>
            </staticText>
            <staticText>
                <reportElement x="374" y="3" width="60" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="436" y="3" width="74" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total (LKR)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <textField>
                <reportElement x="6" y="2" width="100" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{appointmentNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="108" y="2" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="190" y="2" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{dentistName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="282" y="2" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{treatmentName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="374" y="2" width="60" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="436" y="2" width="74" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalAmount}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="21" width="515" height="1"/>
                <graphicElement lineWidth="1" lineColor="#DDDDDD"/>
            </line>
        </band>
    </detail>

    <summary>
        <band height="30" splitType="Stretch">
            <textField>
                <reportElement x="0" y="8" width="515" height="16"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Bill numbers reference the invoice for each completed visit. Amounts shown are in " + $P{CURRENCY} + "."]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
